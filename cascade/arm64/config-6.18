# SmartRG delta on top of the merged upstream filogic + an7581 configs.
# Composed at build time by LINUX_CONF_CMD in smartrg/Makefile:
#   generic + filogic 'm+' an7581 '+' this file
# CPU_FREQ_DEFAULT_GOV stays userspace (fleet parity); AN7581 boards
# get the performance governor from etc/init.d/cpufreq-airoha instead.
CONFIG_AQUANTIA_PHY=y
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=11
CONFIG_ARM64_BRBE=y
# CONFIG_ARMV8_DEPRECATED is not set
CONFIG_ARM_GIC_ITS_PARENT=y
CONFIG_ARM_GIC_V5=y
# CONFIG_BLK_CGROUP is not set
CONFIG_BLK_DEV_LOOP=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_KPROBE_OVERRIDE=y
CONFIG_BT=y
CONFIG_BTT=y
CONFIG_BT_DEBUGFS=y
CONFIG_BT_HCIUART=y
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_INTEL is not set
# CONFIG_BT_HCIUART_NOKIA is not set
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_LE=y
CONFIG_BT_MTK=m
CONFIG_BT_MTKUART=m
CONFIG_BUILDTIME_MCOUNT_SORT=y
CONFIG_CGROUPS=y
# CONFIG_CGROUP_BPF is not set
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_CGROUP_DEVICE is not set
# CONFIG_CGROUP_FREEZER is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_PERF is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_RDMA is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_CMDLINE_OVERRIDE is not set
CONFIG_COMMON_CLK_MT2712=y
# CONFIG_COMMON_CLK_MT2712_BDPSYS is not set
# CONFIG_COMMON_CLK_MT2712_IMGSYS is not set
# CONFIG_COMMON_CLK_MT2712_JPGDECSYS is not set
# CONFIG_COMMON_CLK_MT2712_MFGCFG is not set
# CONFIG_COMMON_CLK_MT2712_MMSYS is not set
# CONFIG_COMMON_CLK_MT2712_VDECSYS is not set
# CONFIG_COMMON_CLK_MT2712_VENCSYS is not set
CONFIG_COMMON_CLK_MT7622=y
CONFIG_COMMON_CLK_MT7622_AUDSYS=y
CONFIG_COMMON_CLK_MT7622_ETHSYS=y
CONFIG_COMMON_CLK_MT7622_HIFSYS=y
CONFIG_COMPAT=y
