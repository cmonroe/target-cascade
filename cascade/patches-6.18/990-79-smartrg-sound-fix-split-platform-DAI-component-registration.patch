From: Chad Monroe <chad@monroe.io>
Date: Tue, 16 Dec 2025 12:16:20 -0800
Subject: [PATCH] ASoC: mediatek: fix split platform/DAI component registration

In kernel 6.12, MediaTek AFE drivers register platform ops and DAIs as
separate components (mtk_afe_pcm_platform and *_afe_pcm_dai_component).
This causes snd_soc_rtdcom_lookup() to fail when searching for "mtk-afe-pcm"
in the frontend rtd, since only the DAI component providing the CPU DAI gets
bound to the rtd.

Additionally, the DAI component lacks platform ops so DMA buffer setup
via pcm_construct never occurs.

Fix by:
1. Adding fallback logic to retrieve the afe pointer from the CPU DAI's
   drvdata when the platform component lookup fails
2. Adding pointer and pcm_construct callbacks to the DAI component
3. Giving the MT7986 DAI component a debugfs_prefix ("dai") so its
   debugfs directory does not collide with the platform component
   (both otherwise derive their name from the device), which silences
   a "debugfs: Directory '<addr>.audio-controller' with parent
   '<card>' already present" warning.

Affects MT7986/MT7988 and MT2701/MT7622.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 sound/soc/mediatek/common/mtk-afe-fe-dai.c |   10 ++++++++--
 sound/soc/mediatek/mt2701/mt2701-afe-pcm.c |    2 ++
 sound/soc/mediatek/mt7986/mt7986-afe-pcm.c |   17 +++++++++++++++--
 3 files changed, 25 insertions(+), 4 deletions(-)

--- a/sound/soc/mediatek/common/mtk-afe-fe-dai.c
+++ b/sound/soc/mediatek/common/mtk-afe-fe-dai.c
@@ -506,10 +506,16 @@ int mtk_memif_set_rate_substream(struct
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_component *component =
 		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
-	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
-
+	struct mtk_base_afe *afe;
 	int fs = 0;
 
+	if (component)
+		afe = snd_soc_component_get_drvdata(component);
+	else
+		afe = snd_soc_dai_get_drvdata(snd_soc_rtd_to_cpu(rtd, 0));
+	if (!afe)
+		return -EINVAL;
+
 	if (!afe->memif_fs) {
 		dev_err(afe->dev, "%s(), error, afe->memif_fs == NULL\n",
 			__func__);
--- a/sound/soc/mediatek/mt2701/mt2701-afe-pcm.c
+++ b/sound/soc/mediatek/mt2701/mt2701-afe-pcm.c
@@ -970,6 +970,8 @@ static int mt2701_afe_pcm_probe(struct s
 static const struct snd_soc_component_driver mt2701_afe_pcm_dai_component = {
 	.probe = mt2701_afe_pcm_probe,
 	.name = "mt2701-afe-pcm-dai",
+	.pointer = mtk_afe_pcm_pointer,
+	.pcm_construct = mtk_afe_pcm_new,
 	.dapm_widgets = mt2701_afe_pcm_widgets,
 	.num_dapm_widgets = ARRAY_SIZE(mt2701_afe_pcm_widgets),
 	.dapm_routes = mt2701_afe_pcm_routes,
--- a/sound/soc/mediatek/mt7986/mt7986-afe-pcm.c
+++ b/sound/soc/mediatek/mt7986/mt7986-afe-pcm.c
@@ -108,7 +108,12 @@ static int mt7986_memif_fs(struct snd_pc
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_component *component = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
-	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mtk_base_afe *afe;
+
+	if (component)
+		afe = snd_soc_component_get_drvdata(component);
+	else
+		afe = snd_soc_dai_get_drvdata(snd_soc_rtd_to_cpu(rtd, 0));
 
 	return mt7986_afe_rate_transform(afe->dev, rate);
 }
@@ -118,7 +123,12 @@ static int mt7986_irq_fs(struct snd_pcm_
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_component *component = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
-	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mtk_base_afe *afe;
+
+	if (component)
+		afe = snd_soc_component_get_drvdata(component);
+	else
+		afe = snd_soc_dai_get_drvdata(snd_soc_rtd_to_cpu(rtd, 0));
 
 	return mt7986_afe_rate_transform(afe->dev, rate);
 }
@@ -192,6 +202,9 @@ static const struct snd_soc_dapm_route m
 
 static const struct snd_soc_component_driver mt7986_afe_pcm_dai_component = {
 	.name = "mt7986-afe-pcm-dai",
+	.debugfs_prefix	= "dai",
+	.pointer	= mtk_afe_pcm_pointer,
+	.pcm_construct	= mtk_afe_pcm_new,
 };
 
 static const struct mtk_base_memif_data memif_data[MT7986_MEMIF_NUM] = {
