From: Chad Monroe <chad@monroe.io>
Date: Sun, 27 Sep 2026 10:08:12 -0700
Subject: [PATCH] net: airoha: release a Wi-Fi local-in entry with its session

Only a session of the Wi-Fi local fastpath can deliver a frame of a
PPE entry that the fastpath bound. The expiry of a session left the
entry bound when dynamic IFC owned the same socket. Each later frame
of the flow then found no session and was dropped.

The expiry of a session now releases its entry, if the entry still
belongs to the flow of the session. A frame without a session
releases its entry and is dropped, so the later frames of its flow
take the normal receive path.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/arht_ppe.c     |   48 +++++++++++++++++++++++++++++
 drivers/net/ethernet/airoha/arht_ppe.h     |    2 +
 drivers/net/ethernet/airoha/arht_wifi_lo.c |   16 +++++++++
 drivers/net/ethernet/airoha/arht_wifi_lo.h |    2 +
 4 files changed, 67 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/airoha/arht_wifi_lo.c
+++ b/drivers/net/ethernet/airoha/arht_wifi_lo.c
@@ -578,16 +578,21 @@ static int wifi_lo_prepare_gro(struct sk
 	struct wifi_lo *lo;
 	struct net_device *dev;
 	struct sock *sk;
+	u16 hash;
 
 	if (unlikely(!skb_mac_header_was_set(skb)))
 		goto free;
 
+	hash = FOE_ENTRY_NUM(skb);
+
 	/* Single RCU section covers the table lookup, the skip_copy set,
 	 * and the dev capture. (12) */
 	rcu_read_lock();
-	lo = wifi_lo_find_by_hash(FOE_ENTRY_NUM(skb));
+	lo = wifi_lo_find_by_hash(hash);
 	if (unlikely(!lo)) {
 		rcu_read_unlock();
+		/* Only a session can deliver a frame of this entry. */
+		arht_general_offload_unbind(hash, PPE_UDF_LOCAL_IN_NS, 0, 0);
 		goto free;
 	}
 
@@ -690,6 +695,7 @@ static void wifi_lo_timeout(struct timer
 	struct dst_entry *dst_to_release = NULL;
 	struct sock *sk_to_release = NULL;
 	bool difc_active = false;
+	u16 hash, lport, rport;
 
 	spin_lock_bh(&wifi_lo_lock);
 	if (time_before(jiffies, e->last_tx + WIFI_LO_EXPIRE_TIME)) {
@@ -731,10 +737,18 @@ static void wifi_lo_timeout(struct timer
 
 	clear_bit(WIFI_LO_F_IS_WIFI, &e->flags);
 	clear_bit(WIFI_LO_F_VALID,   &e->flags);
+	hash = e->hash;
+	lport = ntohs(e->lport);
+	rport = ntohs(e->rport);
 	e->hash = 0;
 
 	spin_unlock_bh(&wifi_lo_lock);
 
+	/* The clean by port runs later, and not for a flow of dynamic IFC. */
+	if (hash)
+		arht_general_offload_unbind(hash, PPE_UDF_LOCAL_IN_NS,
+					    rport, lport);
+
 	if (atomic_dec_return(&wifi_lo_active_num) == 0)
 		schedule_work(&wifi_lo_active_sync);	/* flip key -> off */
 
--- a/drivers/net/ethernet/airoha/arht_wifi_lo.h
+++ b/drivers/net/ethernet/airoha/arht_wifi_lo.h
@@ -145,6 +145,8 @@ extern int (*arht_force_to_cpu_prepare_g
 extern int (*local_out_pingpong_hook)(struct sk_buff *skb);
 extern int (*dynamic_ifc_sock_in_use_hook)(u16 lport, u16 rport);
 extern int (*ra_sw_nat_hook_clean_entry_by_port)(u16 src_port, u16 dest_port);
+extern void arht_general_offload_unbind(u32 foe_entry_idx, unsigned short type,
+					u16 src_port, u16 dest_port);
 extern struct dst_entry *arht_gen_dst_clone(struct dst_entry *dst);
 
 #endif
--- a/drivers/net/ethernet/airoha/arht_ppe.c
+++ b/drivers/net/ethernet/airoha/arht_ppe.c
@@ -1475,6 +1475,54 @@ unlock:
 }
 EXPORT_SYMBOL(arht_general_offload_bind);
 
+void arht_general_offload_unbind(u32 foe_entry_idx, unsigned short type,
+				 u16 src_port, u16 dest_port)
+{
+	struct airoha_foe_entry *hwe;
+	u16 etype, sp, dp;
+
+	if (!glb_eth || !glb_eth->ppe)
+		return;
+
+	if (foe_entry_idx >= glb_eth->soc->ppe_sram_etry_num)
+		return;
+
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_foe_get_entry_locked(glb_eth->ppe, foe_entry_idx);
+	if (!hwe)
+		goto unlock;
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) != AIROHA_FOE_STATE_BIND)
+		goto unlock;
+
+	switch (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1)) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+		etype = hwe->ipv4.l2.common.etype;
+		sp = hwe->ipv4.orig_tuple.src_port;
+		dp = hwe->ipv4.orig_tuple.dest_port;
+		break;
+	case PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		etype = hwe->ipv6.l2.etype;
+		sp = hwe->ipv6.src_port;
+		dp = hwe->ipv6.dest_port;
+		break;
+	default:
+		goto unlock;
+	}
+
+	if (etype != type)
+		goto unlock;
+
+	/* Another flow can hold the index by now. */
+	if ((src_port || dest_port) && (sp != src_port || dp != dest_port))
+		goto unlock;
+
+	airoha_ppe_delete_entry(glb_eth->ppe, hwe, foe_entry_idx);
+unlock:
+	spin_unlock_bh(&ppe_lock);
+}
+EXPORT_SYMBOL(arht_general_offload_unbind);
+
 inline static int airoha_is_local_out(struct sk_buff *skb)
 {
 	return (skb->inner_protocol == PPE_MAGIC_LOCAL_OUT || skb->inner_protocol == PPE_MAGIC_DYNAMIC_IFC);
--- a/drivers/net/ethernet/airoha/arht_ppe.h
+++ b/drivers/net/ethernet/airoha/arht_ppe.h
@@ -140,6 +140,8 @@ int arht_multicast_handler_for_sfu(struc
 int find_and_update_shrink_table(int select, struct hwnat_shrink_field *shrinkFieldPtr);
 int ppe_dump_shrink_table(void);
 int arht_general_offload_bind(struct sk_buff * skb, unsigned short type);
+void arht_general_offload_unbind(u32 foe_entry_idx, unsigned short type,
+				 u16 src_port, u16 dest_port);
 int airoha_ppe_tx_handler(struct sk_buff *skb, struct port_info *pinfo, u8 fport);
 void arht_ppe_general_init(struct airoha_ppe *ppe);
 void arht_ppe_general_exit(void);
