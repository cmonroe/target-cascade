From: Chad Monroe <chad@monroe.io>
Date: Sun, 27 Sep 2026 11:09:11 -0700
Subject: [PATCH] net: airoha: do not drive phylink for internal GDM MACs

The 6.18 driver connects and starts phylink at each open. The
internal GDM MACs, the switch conduit and the PON MAC, have no PHY
to attach, so their open failed. phylink also clears the carrier at
its creation, so an internal MAC that does not start phylink stays
without carrier.

Only a port with an external PHY now drives phylink at open and
stop. An internal MAC raises its carrier at open and drops it at
stop. The phylink objects still exist for all ports.

Co-developed-by: Scott Iveland <scott.iveland@adtran.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/airoha_eth.c |   40 ++++++++++++++++-----
 1 file changed, 32 insertions(+), 8 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2188,6 +2188,19 @@ static void airoha_qdma_gro_hw_sync(stru
 	}
 }
 
+/* Internal GDM MACs (embedded switch on GDM1, PON on GDM2) have no
+ * attachable PHY; only external-PHY ports drive phylink at open/stop.
+ * The 6.18 mainline refactor connects phylink unconditionally, which
+ * fails these ports with -ENODEV; restore the vendor guard.
+ */
+static bool airoha_is_phy_external(struct airoha_gdm_port *port)
+{
+	if (port->eth->extra_ops.sel_phy_external)
+		return port->eth->extra_ops.sel_phy_external(port);
+
+	return port->id != AIROHA_GDM1_IDX;
+}
+
 static int airoha_dev_open(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
@@ -2199,14 +2212,21 @@ static int airoha_dev_open(struct net_de
 
 	qdma = airoha_qdma_deref(dev);
 
-	err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
-	if (err) {
-		netdev_err(netdev, "could not attach PHY: %d\n", err);
-		return err;
+	if (airoha_is_phy_external(port)) {
+		err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
+		if (err) {
+			netdev_err(netdev, "could not attach PHY: %d\n", err);
+			return err;
+		}
+
+		phylink_start(dev->phylink);
+	} else {
+		/* phylink_create() clears carrier and internal GDM MACs
+		 * never start phylink, so raise carrier manually
+		 */
+		netif_carrier_on(netdev);
 	}
 
-	phylink_start(dev->phylink);
-
 	netif_tx_start_all_queues(netdev);
 	err = airoha_set_vip_for_gdm_port(dev, true);
 	if (err)
@@ -2266,8 +2286,12 @@ static int airoha_dev_stop(struct net_de
 	airoha_qdma_stop(qdma);
 	airoha_update_netdev_features(dev);
 
-	phylink_stop(dev->phylink);
-	phylink_disconnect_phy(dev->phylink);
+	if (airoha_is_phy_external(port)) {
+		phylink_stop(dev->phylink);
+		phylink_disconnect_phy(dev->phylink);
+	} else {
+		netif_carrier_off(netdev);
+	}
 
 	return 0;
 }
