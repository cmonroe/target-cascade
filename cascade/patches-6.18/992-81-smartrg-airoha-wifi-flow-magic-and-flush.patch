From: Chad Monroe <chad@monroe.io>
Date: Wed, 01 Jul 2026 14:44:10 -0700
Subject: [PATCH] airoha: add WIFI flow magic and flush on wifi netdev events

Wifi-egress PPE flows carry no e_magic classification and show a
null destination in the foe_flow debugfs dump. Tag them with a new
WIFI value.

Wifi flows are never retired by the eth QDMA TX paths and mt7996
TX is outside the airoha datapath, so nothing cleans them up when
an AP vif goes down or an AP_VLAN is removed on 4-address STA
disconnect. Flush wifi flows (egress e_magic WIFI or ingress
WIFI_DEV) from the PPE netdevice notifier on NETDEV_DOWN and
NETDEV_UNREGISTER of mac80211 netdevs, reusing the conntrack
teardown walk shared with airoha_flow_table_entries_lan().

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/airoha_eth.h          |    1 
 drivers/net/ethernet/airoha/airoha_function.h     |    1 
 drivers/net/ethernet/airoha/arht_dp_api.c         |   27 ++++++++----
 drivers/net/ethernet/airoha/arht_dp_api_debugfs.c |    1 
 drivers/net/ethernet/airoha/arht_ppe.c            |    9 ++++
 5 files changed, 31 insertions(+), 8 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -591,6 +591,7 @@ enum magic {
 	LAN2 = 4,
 	LAN3 = 5,
 	LAN4 = 6,
+	WIFI = 7,
 };
 
 struct airoha_flow_table_entry {
--- a/drivers/net/ethernet/airoha/airoha_function.h
+++ b/drivers/net/ethernet/airoha/airoha_function.h
@@ -45,6 +45,7 @@ extern int airoha_hsgmii_init(void);
 extern void airoha_hsgmii_exit(void);
 int airoha_get_lan_id(struct net_device *dev);
 void airoha_flow_table_entries_lan(struct rhashtable *flow_table, struct net_device *dev);
+void airoha_flow_table_entries_wifi(struct rhashtable *flow_table);
 int airoha_receive_hook(struct airoha_queue *q, struct airoha_qdma_desc *desc, 
 				int p, int len);
 void arht_conntrack_get_cnt(u32 hash, struct airoha_foe_stats64 *stats);
--- a/drivers/net/ethernet/airoha/arht_dp_api.c
+++ b/drivers/net/ethernet/airoha/arht_dp_api.c
@@ -617,13 +617,12 @@ static void delete_conntrack_by_tuple(__
 	
 }
 
-void airoha_flow_table_entries_lan(struct rhashtable *flow_table, struct net_device *dev)
+static void airoha_flow_table_entries_flush(struct rhashtable *flow_table, int magic, u32 ingress_idx)
 {
     struct airoha_flow_table_entry *e = NULL;
     struct rhashtable_iter iter = {0};
     int ret = 0;
-    int lan_idx = airoha_get_lan_id(dev);
-    
+
     rhashtable_walk_enter(flow_table, &iter);
     ret = rhashtable_walk_start_check(&iter);
     if (ret) {
@@ -638,7 +637,7 @@ void airoha_flow_table_entries_lan(struc
 		{
 			break;
 		}
-        if (lan_idx == e->e_magic || lan_idx == e->ingress_dev_idx) {
+        if (magic == e->e_magic || ingress_idx == e->ingress_dev_idx) {
             int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
 			u32 state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, e->data.ib1);
 			u8 is_udp = FIELD_GET(AIROHA_FOE_IB1_BIND_UDP, e->data.ib1);
@@ -647,12 +646,12 @@ void airoha_flow_table_entries_lan(struc
 			if (state != AIROHA_FOE_STATE_BIND)
 				continue;
 
-			AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "airoha_flow_table_entries_lan found flow entry: cookie=%lx ingress_dev_idx=%u, e->magic=%d and lan_idx=%d\n",
-                   e->cookie, e->ingress_dev_idx, e->e_magic, lan_idx);
-			
+			AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "%s found flow entry: cookie=%lx ingress_dev_idx=%u, e->magic=%d and magic=%d\n",
+                   __func__, e->cookie, e->ingress_dev_idx, e->e_magic, magic);
+
 			if (type == PPE_PKT_TYPE_IPV4_HNAPT || type == PPE_PKT_TYPE_IPV4_ROUTE) {
                 struct airoha_foe_ipv4_tuple *tuple = &e->data.ipv4.orig_tuple;
-				
+
                 delete_conntrack_by_tuple(ntohl(tuple->src_ip), ntohl(tuple->dest_ip),
                                          ntohs(tuple->src_port), ntohs(tuple->dest_port),l4proto);
             } else if (type == PPE_PKT_TYPE_IPV4_DSLITE) {
@@ -677,6 +676,18 @@ out:
     rhashtable_walk_exit(&iter);
 }
 
+void airoha_flow_table_entries_lan(struct rhashtable *flow_table, struct net_device *dev)
+{
+    int lan_idx = airoha_get_lan_id(dev);
+
+    airoha_flow_table_entries_flush(flow_table, lan_idx, lan_idx);
+}
+
+void airoha_flow_table_entries_wifi(struct rhashtable *flow_table)
+{
+    airoha_flow_table_entries_flush(flow_table, WIFI, WIFI_DEV);
+}
+
 
 int airoha_is_pon_sfu_mode(void)
 {
--- a/drivers/net/ethernet/airoha/arht_dp_api_debugfs.c
+++ b/drivers/net/ethernet/airoha/arht_dp_api_debugfs.c
@@ -439,6 +439,7 @@ static int airoha_ppe_debugfs_foe_flow_s
 		[LAN2] = "LAN2",
 		[LAN3] = "LAN3",
 		[LAN4] = "LAN4",
+		[WIFI] = "WIFI",
 	};
 
 	static const char *const ppe_type[] = {
--- a/drivers/net/ethernet/airoha/arht_ppe.c
+++ b/drivers/net/ethernet/airoha/arht_ppe.c
@@ -3493,6 +3493,7 @@ void airoha_set_flow_destination(struct
 
         if(arht_foe_entry_is_wifi(&e->data)){
                 AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "destination set to WIFI\n");
+                e->e_magic = WIFI;
                 /* mt76 NPU egress is fully described at rule-replace time via
                  * dev_fill_forward_path(); no QDMA TX pass ever runs for wifi
                  * to set tx_modified, so grant commit-eligibility here.
@@ -4163,6 +4164,14 @@ static int airoha_ppe_netdev_event(struc
 	switch (event) {
 	case NETDEV_UNREGISTER:
 		airoha_ppe_clean_entry_by_landev(dev);
+		fallthrough;
+	case NETDEV_DOWN:
+		/* mac80211 netdevs (AP vif down, AP_VLAN removal on STA
+		 * disconnect) never traverse the QDMA TX paths that retire
+		 * eth flows, so flush wifi flows here.
+		 */
+		if (dev->ieee80211_ptr && glb_eth)
+			airoha_flow_table_entries_wifi(&glb_eth->flow_table);
 		break;
 	default:
 		break;
