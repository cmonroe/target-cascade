+typedef void (*mt7530_mib_stats_fn)(struct rtnl_link_stats64 *, u64);
+
+struct mt7530_mib_desc {
+	unsigned int size;
+	unsigned int offset;
+	mt7530_mib_stats_fn stats;
+	const char *name;
+};
+
+#define MIB_DESC(_s, _o, _fn, _n)	\
+{			\
+	.size = (_s),	\
+	.offset = (_o),	\
+	.stats = (_fn), \
+	.name = (_n),	\
+}
