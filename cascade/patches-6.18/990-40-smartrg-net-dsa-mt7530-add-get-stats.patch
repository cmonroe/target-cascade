+static inline void mt7530_update_tx_bytes(struct rtnl_link_stats64 *s, u64 v) { s->tx_bytes += v; }
+static inline void mt7530_update_tx_dropped(struct rtnl_link_stats64 *s, u64 v) { s->tx_dropped += v; }
+static inline void mt7530_update_tx_packets(struct rtnl_link_stats64 *s, u64 v) { s->tx_packets += v; }
+static inline void mt7530_update_tx_errors(struct rtnl_link_stats64 *s, u64 v) { s->tx_errors += v; }
+static inline void mt7530_update_collisions(struct rtnl_link_stats64 *s, u64 v) { s->collisions += v; }
+static inline void mt7530_update_rx_bytes(struct rtnl_link_stats64 *s, u64 v) { s->rx_bytes += v; }
+static inline void mt7530_update_rx_dropped(struct rtnl_link_stats64 *s, u64 v) { s->rx_dropped += v; }
+static inline void mt7530_update_rx_packets(struct rtnl_link_stats64 *s, u64 v) { s->rx_packets += v; }
+static inline void mt7530_update_rx_errors(struct rtnl_link_stats64 *s, u64 v) { s->rx_errors += v; }
+static inline void mt7530_update_rx_crc_errors(struct rtnl_link_stats64 *s, u64 v) { s->rx_crc_errors += v; }
+
+static inline void mt7530_update_rx_length_errors(struct rtnl_link_stats64 *s, u64 v)
+{
+	s->rx_errors += v;
+	s->rx_length_errors += v;
+}
+
+static inline void mt7530_update_tx_multicast(struct rtnl_link_stats64 *s, u64 v)
+{
+	s->multicast += v;
+	s->tx_packets += v;
+}
+
+static inline void mt7530_update_rx_multicast(struct rtnl_link_stats64 *s, u64 v)
+{
+	s->multicast += v;
+	s->rx_packets += v;
+}
