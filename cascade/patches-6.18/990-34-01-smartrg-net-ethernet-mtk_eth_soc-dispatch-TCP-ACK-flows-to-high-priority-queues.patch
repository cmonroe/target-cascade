+			   const u8 *dest_mac, int *wed_index)
 {
 	struct mtk_wdma_info info = {};
 	struct mtk_mac *mac;
@@ -273,6 +363,16 @@ mtk_flow_set_output_device(struct mtk_et
 	} else {
 		queue = pse_port - 1;
 	}
+
+	/* TCP ACK flows go onto the high-priority half of the PPPQ
+	 * range so they are not queued behind bulk data on the same
+	 * egress port. Applies to both DSA user ports and direct GMAC
+	 * egress.
+	 */
+	if (ct && nf_ct_protonum(ct) == IPPROTO_TCP &&
+	    mtk_flow_is_tcp_ack(eth, foe, ct))
+		queue += mtk_pppq_ack_queue_offset(eth);
+
 	mtk_foe_entry_set_queue(eth, foe, queue);
 
