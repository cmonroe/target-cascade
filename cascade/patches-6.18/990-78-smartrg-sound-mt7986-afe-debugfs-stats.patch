From: Chad Monroe <chad@monroe.io>
Date: Tue, 15 Sep 2026 12:15:00 -0700
Subject: [PATCH] ASoC: mediatek: mt7986: add an AFE debugfs stats node

The MT7987 voice units show rare engine hold episodes that the
engine counters alone cannot attribute: the driver gives no view of
the AFE interrupt cadence or of the DMA position.

Add /sys/kernel/debug/mt7986-afe/stats with per-source interrupt
counts and gap tracking, a status mask histogram, and position
register sampling per memif. The counters are lockless single
writer; the added interrupt cost is one ktime read and one position
register read per active memif.

mt7986_irq_fs() stamps the session start and the handler ignores a
baseline older than the stamp, so a handler that outlives a stop and
start cannot make a gap span the session boundary. The show function
takes no driver lock and never dereferences substream->runtime, which
the PCM close path frees. Removal runs first in .remove, before the
runtime PM shutdown gates the hardware. The register header defines
no underflow or overflow status register; the four MON registers
print raw.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 sound/soc/mediatek/mt7986/mt7986-afe-common.h |   21 +++
 sound/soc/mediatek/mt7986/mt7986-afe-pcm.c    |  170 +++++++++++++++++++++++++-
 2 files changed, 189 insertions(+), 2 deletions(-)

--- a/sound/soc/mediatek/mt7986/mt7986-afe-common.h
+++ b/sound/soc/mediatek/mt7986/mt7986-afe-common.h
@@ -31,12 +31,33 @@ enum {
 	MT7986_IRQ_NUM,
 };
 
+struct mt7986_afe_stats {
+	u64 irq_total;
+	u64 irq_err;
+	u64 irq_status_hist[1 << MT7986_IRQ_NUM];
+	u64 irq_count[MT7986_IRQ_NUM];
+	u64 irq_session_ns[MT7986_IRQ_NUM];
+	u64 irq_last_ns[MT7986_IRQ_NUM];
+	u64 irq_max_gap_ns[MT7986_IRQ_NUM];
+	u64 irq_gap_over[MT7986_IRQ_NUM];
+	u64 irq_gap_over_last_ns[MT7986_IRQ_NUM];
+	u64 irq_gap_over_last_gap_ns[MT7986_IRQ_NUM];
+	u64 elapsed_calls[MT7986_MEMIF_NUM];
+	u64 pos_unchanged[MT7986_MEMIF_NUM];
+	u32 last_cur[MT7986_MEMIF_NUM];
+};
+
+struct dentry;
+
 struct mt7986_afe_private {
 	struct clk_bulk_data *clks;
 	int num_clks;
 
 	int pm_runtime_bypass_reg_ctl;
 
+	struct mt7986_afe_stats stats;
+	struct dentry *debugfs;
+
 	/* dai */
 	void *dai_priv[MT7986_DAI_NUM];
 };
--- a/sound/soc/mediatek/mt7986/mt7986-afe-pcm.c
+++ b/sound/soc/mediatek/mt7986/mt7986-afe-pcm.c
@@ -8,7 +8,9 @@
  */
 
 #include <linux/clk.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
@@ -19,6 +21,8 @@
 #include "../common/mtk-afe-platform-driver.h"
 #include "../common/mtk-afe-fe-dai.h"
 
+#define MT7986_AFE_GAP_OVER_NS	(20 * NSEC_PER_MSEC)
+
 enum {
 	MTK_AFE_RATE_8K = 0,
 	MTK_AFE_RATE_11K = 1,
@@ -123,13 +127,27 @@ static int mt7986_irq_fs(struct snd_pcm_
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_component *component = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct mt7986_afe_private *afe_priv;
 	struct mtk_base_afe *afe;
+	int id = snd_soc_rtd_to_cpu(rtd, 0)->id;
 
 	if (component)
 		afe = snd_soc_component_get_drvdata(component);
 	else
 		afe = snd_soc_dai_get_drvdata(snd_soc_rtd_to_cpu(rtd, 0));
 
+	/*
+	 * Stamp the session start; the handler treats a baseline older
+	 * than the stamp as invalid, so a stale handler write cannot
+	 * make a gap span the stop-start boundary.
+	 */
+	afe_priv = afe->platform_priv;
+	if (id < MT7986_MEMIF_NUM && afe->memif[id].irq_usage >= 0) {
+		afe_priv->stats.irq_session_ns[afe->memif[id].irq_usage] =
+			ktime_get_ns();
+		afe_priv->stats.last_cur[id] = 0;
+	}
+
 	return mt7986_afe_rate_transform(afe->dev, rate);
 }
 
@@ -355,8 +373,11 @@ static int mt7986_init_clock(struct mtk_
 static irqreturn_t mt7986_afe_irq_handler(int irq_id, void *dev)
 {
 	struct mtk_base_afe *afe = dev;
+	struct mt7986_afe_private *afe_priv = afe->platform_priv;
+	struct mt7986_afe_stats *stats = &afe_priv->stats;
 	struct mtk_base_afe_irq *irq;
-	u32 mcu_en, status, status_mcu;
+	u32 mcu_en, status, status_mcu, cur;
+	u64 now;
 	int i, ret;
 	irqreturn_t irq_ret = IRQ_HANDLED;
 
@@ -371,10 +392,36 @@ static irqreturn_t mt7986_afe_irq_handle
 		dev_err(afe->dev, "%s(), irq status err, ret %d, status 0x%x, mcu_en 0x%x\n",
 			__func__, ret, status, mcu_en);
 
+		stats->irq_err++;
 		irq_ret = IRQ_NONE;
 		goto err_irq;
 	}
 
+	now = ktime_get_ns();
+	stats->irq_total++;
+	stats->irq_status_hist[status_mcu]++;
+
+	for (i = 0; i < MT7986_IRQ_NUM; i++) {
+		bool valid;
+		u64 gap;
+
+		if (!(status_mcu & BIT(i)))
+			continue;
+
+		stats->irq_count[i]++;
+		valid = stats->irq_last_ns[i] &&
+			stats->irq_last_ns[i] >= stats->irq_session_ns[i];
+		gap = now - stats->irq_last_ns[i];
+		if (valid && gap > stats->irq_max_gap_ns[i])
+			stats->irq_max_gap_ns[i] = gap;
+		if (valid && gap > MT7986_AFE_GAP_OVER_NS) {
+			stats->irq_gap_over[i]++;
+			stats->irq_gap_over_last_ns[i] = now;
+			stats->irq_gap_over_last_gap_ns[i] = gap;
+		}
+		stats->irq_last_ns[i] = now;
+	}
+
 	for (i = 0; i < MT7986_MEMIF_NUM; i++) {
 		struct mtk_base_afe_memif *memif = &afe->memif[i];
 
@@ -386,8 +433,17 @@ static irqreturn_t mt7986_afe_irq_handle
 
 		irq = &afe->irqs[memif->irq_usage];
 
-		if (status_mcu & (1 << irq->irq_data->irq_en_shift))
+		if (status_mcu & BIT(irq->irq_data->irq_clr_shift)) {
+			regmap_read(afe->regmap, memif->data->reg_ofs_cur, &cur);
+			if (cur == stats->last_cur[i])
+				stats->pos_unchanged[i]++;
+			stats->last_cur[i] = cur;
+		}
+
+		if (status_mcu & (1 << irq->irq_data->irq_en_shift)) {
+			stats->elapsed_calls[i]++;
 			snd_pcm_period_elapsed(memif->substream);
+		}
 	}
 
 err_irq:
@@ -397,6 +453,101 @@ err_irq:
 	return irq_ret;
 }
 
+static int mt7986_afe_stats_show(struct seq_file *s, void *unused)
+{
+	static const struct {
+		const char *name;
+		unsigned int reg;
+	} mon_regs[] = {
+		{ "memif_rd_mon", AFE_MEMIF_RD_MON },
+		{ "memif_wr_mon", AFE_MEMIF_WR_MON },
+		{ "dl0_rch_mon", AFE_DL0_RCH_MON },
+		{ "dl0_lch_mon", AFE_DL0_LCH_MON },
+	};
+	struct mtk_base_afe *afe = s->private;
+	struct mt7986_afe_private *afe_priv = afe->platform_priv;
+	struct mt7986_afe_stats *stats = &afe_priv->stats;
+	u32 val, cfg0, cfg1;
+	int i, ret;
+
+	seq_printf(s, "snapshot_ns %llu\n", ktime_get_ns());
+	seq_printf(s, "irq_total %llu\n", stats->irq_total);
+	seq_printf(s, "irq_err %llu\n", stats->irq_err);
+
+	for (i = 0; i < ARRAY_SIZE(stats->irq_status_hist); i++)
+		seq_printf(s, "irq_status_hist%d %llu\n", i,
+			   stats->irq_status_hist[i]);
+
+	for (i = 0; i < MT7986_IRQ_NUM; i++)
+		seq_printf(s, "irq%d count %llu session_ns %llu last_ns %llu max_gap_ns %llu gap_over %llu gap_over_last_ns %llu gap_over_last_gap_ns %llu\n",
+			   i, stats->irq_count[i], stats->irq_session_ns[i],
+			   stats->irq_last_ns[i],
+			   stats->irq_max_gap_ns[i], stats->irq_gap_over[i],
+			   stats->irq_gap_over_last_ns[i],
+			   stats->irq_gap_over_last_gap_ns[i]);
+
+	ret = pm_runtime_resume_and_get(afe->dev);
+	if (ret < 0) {
+		seq_puts(s, "registers unavailable\n");
+		return 0;
+	}
+
+	regmap_read(afe->regmap, AFE_IRQ_MCU_EN, &val);
+	seq_printf(s, "irq_mcu_en 0x%08x\n", val);
+	regmap_read(afe->regmap, AFE_IRQ_MCU_STATUS, &val);
+	seq_printf(s, "irq_mcu_status 0x%08x\n", val);
+
+	for (i = 0; i < MT7986_IRQ_NUM; i++) {
+		regmap_read(afe->regmap, irq_data[i].irq_fs_reg, &cfg0);
+		regmap_read(afe->regmap, irq_data[i].irq_cnt_reg, &cfg1);
+		seq_printf(s, "irq%d cfg0 0x%08x cfg1 0x%08x period_frames %u\n",
+			   i, cfg0, cfg1, cfg1 & AFE_IRQ_CNT_MASK);
+	}
+
+	regmap_read(afe->regmap, ETDM_IN5_CON0, &val);
+	seq_printf(s, "etdm_in5_con0 0x%08x en %d\n", val, !!(val & ETDM_EN));
+	regmap_read(afe->regmap, ETDM_OUT5_CON0, &val);
+	seq_printf(s, "etdm_out5_con0 0x%08x en %d\n", val, !!(val & ETDM_EN));
+
+	for (i = 0; i < ARRAY_SIZE(mon_regs); i++) {
+		regmap_read(afe->regmap, mon_regs[i].reg, &val);
+		seq_printf(s, "%s 0x%08x\n", mon_regs[i].name, val);
+	}
+
+	for (i = 0; i < MT7986_MEMIF_NUM; i++) {
+		struct mtk_base_afe_memif *memif = &afe->memif[i];
+		const struct mtk_base_memif_data *data = memif->data;
+		u32 con0, base, cur, end;
+
+		regmap_read(afe->regmap, data->enable_reg, &con0);
+		regmap_read(afe->regmap, data->reg_ofs_base, &base);
+		regmap_read(afe->regmap, data->reg_ofs_cur, &cur);
+		regmap_read(afe->regmap, data->reg_ofs_end, &end);
+		seq_printf(s, "%s con0 0x%08x on %u base 0x%08x cur 0x%08x end 0x%08x buf_bytes %u\n",
+			   data->name, con0,
+			   (con0 >> data->enable_shift) & 1,
+			   base, cur, end, end - base + 1);
+		seq_printf(s, "%s last_cur 0x%08x elapsed_calls %llu pos_unchanged %llu irq_usage %d open %d\n",
+			   data->name, stats->last_cur[i],
+			   stats->elapsed_calls[i], stats->pos_unchanged[i],
+			   memif->irq_usage, !!READ_ONCE(memif->substream));
+	}
+
+	pm_runtime_put(afe->dev);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7986_afe_stats);
+
+static void mt7986_afe_debugfs_remove(void *data)
+{
+	struct mtk_base_afe *afe = data;
+	struct mt7986_afe_private *afe_priv = afe->platform_priv;
+
+	debugfs_remove(afe_priv->debugfs);
+	afe_priv->debugfs = NULL;
+}
+
 static int mt7986_afe_runtime_suspend(struct device *dev)
 {
 	struct mtk_base_afe *afe = dev_get_drvdata(dev);
@@ -550,6 +701,13 @@ static int mt7986_afe_pcm_dev_probe(stru
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to request irq for asys-isr\n");
 
+	afe_priv->debugfs = debugfs_create_dir("mt7986-afe", NULL);
+	ret = devm_add_action_or_reset(dev, mt7986_afe_debugfs_remove, afe);
+	if (ret)
+		return ret;
+	debugfs_create_file("stats", 0444, afe_priv->debugfs, afe,
+			    &mt7986_afe_stats_fops);
+
 	/* init sub_dais */
 	INIT_LIST_HEAD(&afe->sub_dais);
 
@@ -590,6 +748,14 @@ static int mt7986_afe_pcm_dev_probe(stru
 
 static void mt7986_afe_pcm_dev_remove(struct platform_device *pdev)
 {
+	struct mtk_base_afe *afe = platform_get_drvdata(pdev);
+
+	/*
+	 * Drain stats readers before the hardware is suspended below;
+	 * the devm action runs only after this and then finds NULL.
+	 */
+	mt7986_afe_debugfs_remove(afe);
+
 	pm_runtime_disable(&pdev->dev);
 	if (!pm_runtime_status_suspended(&pdev->dev))
 		mt7986_afe_runtime_suspend(&pdev->dev);
