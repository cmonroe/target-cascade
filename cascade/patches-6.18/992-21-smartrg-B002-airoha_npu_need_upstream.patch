+static int airoha_npu_wait_init_complete(struct airoha_npu *npu)
+{
+	int reg_val;
+
+	regmap_read(npu->regmap, CR_NPU_MIB31, &reg_val);
+	while (reg_val != INIT_COMPELET) {
+		msleep(100);
+		regmap_read(npu->regmap, CR_NPU_MIB31, &reg_val);
+	}
+	return 0;
+}
+static int airoha_npu_wlan_cmd_with_retry(struct airoha_npu *npu, int ifindex,
+					  enum airoha_npu_wlan_set_cmd cmd,
+					  const char *name, int is_msg_send, u32 *val)
+{
+	int err = 0, retry_cnt = 3;
+
+	while (retry_cnt) {
+		if (is_msg_send)
+			err = airoha_npu_wlan_msg_send(npu, ifindex, cmd, val, sizeof(*val), GFP_KERNEL);
+		else
+			err = airoha_npu_wlan_set_reserved_memory(npu, ifindex, name, cmd);
+		if (!err)
+			break;
+		mdelay(10);
+		retry_cnt--;
+	}
+	mdelay(10);
+	if (!retry_cnt)
+		return err;
+	return 0;
+}
