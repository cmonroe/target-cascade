From: Chad Monroe <chad@monroe.io>
Date: Tue, 30 Jun 2026 17:57:03 -0700
Subject: [PATCH] net: airoha: 6.18 kernel build compatibility shims

Bridge the API gap that prevents the SmartRG/Adtran Airoha vendor
overlay from building against the 6.18 airoha driver, keeping the
pristine overlay sources unchanged:

- airoha_gdm_dev lost its net_device back-pointer; upstream now uses
  netdev_from_priv(), but the PON offload overlay (arht_dp_api.c and
  related files) reads gdm_dev->dev directly. Restore the member and
  set it at device allocation.

The from_timer()/del_timer() aliases previously carried here were only
needed by arht_dynamic_ifc.c, which the 2026Q2 vendor drop removed.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/airoha_eth.c |    1 +
 drivers/net/ethernet/airoha/airoha_eth.h |    1 +
 2 files changed, 2 insertions(+)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4045,6 +4045,7 @@ static int airoha_alloc_gdm_device(struc
 
 	netdev->dev.of_node = of_node_get(np);
 	dev = netdev_priv(netdev);
+	dev->dev = netdev;
 	u64_stats_init(&dev->stats.syncp);
 	dev->port = port;
 	dev->eth = eth;
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -672,6 +672,7 @@ struct airoha_gdm_dev {
 	struct airoha_qdma __rcu *qdma;
 	struct airoha_gdm_port *port;
 	struct airoha_eth *eth;
+	struct net_device *dev;
 
 	DECLARE_BITMAP(qos_sq_bmap, AIROHA_NUM_QOS_CHANNELS);
 	/* qos stats counters */
--- a/drivers/net/ethernet/airoha/arht_dynamic_ifc.c
+++ b/drivers/net/ethernet/airoha/arht_dynamic_ifc.c
@@ -412,7 +412,7 @@ static struct dynamic_ifc* find_dynamic_
 
 static void dynamic_ifc_timeout(struct timer_list *arg)
 {
-	struct dynamic_ifc *e = from_timer(e, arg, age_timer);
+	struct dynamic_ifc *e = timer_container_of(e, arg, age_timer);
 	int i;
 	unsigned long flags;
 	struct sock *sk_to_release = NULL;
@@ -893,7 +893,7 @@ static void dynamic_ifc_cleanup_all_sess
 	
 	for (i = 0; i < MAX_DYNAMIC_IFC_NUM; i++) {
 		if (need_timer_sync[i])
-			del_timer_sync(&dynamic_ifc_ety[i].age_timer);
+			timer_delete_sync(&dynamic_ifc_ety[i].age_timer);
 	}
 
 	spin_lock_irqsave(&dynamic_ifc_lock, flags);
--- a/drivers/net/ethernet/airoha/arht_wifi_lo.c
+++ b/drivers/net/ethernet/airoha/arht_wifi_lo.c
@@ -746,7 +746,7 @@ static int wifi_lo_pingpong(struct sk_bu
 
 static void wifi_lo_timeout(struct timer_list *arg)
 {
-	struct wifi_lo *e = from_timer(e, arg, age_timer);
+	struct wifi_lo *e = timer_container_of(e, arg, age_timer);
 	int (*sock_in_use_fn)(u16, u16);
 	int (*ppe_clean_fn)(u16, u16);
 	struct dst_entry *dst_to_release = NULL;
@@ -1280,7 +1280,7 @@ static void __exit wifi_lo_exit(void)
 	synchronize_rcu();
 
 	for (i = 0; i < WIFI_LO_MAX_NUM; i++)
-		del_timer_sync(&wifi_lo_ety[i].age_timer);
+		timer_delete_sync(&wifi_lo_ety[i].age_timer);
 
 	spin_lock_bh(&wifi_lo_lock);
 	for (i = 0; i < WIFI_LO_MAX_NUM; i++) {
