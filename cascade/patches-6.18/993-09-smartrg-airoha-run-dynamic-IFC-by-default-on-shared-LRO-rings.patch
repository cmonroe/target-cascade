+/* Ring 12 shares its interrupt with the TX completions, so it goes last. */
+static int ifc_slot_ring_get(unsigned int slot)
+{
+	return IFC_LRO_RING_START + (slot + 1) % IFC_LRO_RING_NUM;
+}
+
+/* An IFC rule matches on both ingress sides, so the ring must be an LRO
+ * ring on both QDMAs. The ethernet driver enables LRO only on a ring
+ * with descriptors, so a ring without them is not an LRO ring here.
+ */
+static bool ifc_ring_is_lro(int ring)
+{
+	struct airoha_eth *eth = READ_ONCE(glb_eth);
+	int i;
+
+	if (!eth)
+		return false;
+
+	for (i = 0; i < AIROHA_MAX_NUM_QDMA; i++) {
+		struct airoha_queue *q = &eth->qdma[i].q_rx[ring];
+
+		if (!q->ndesc || !airoha_qdma_is_lro_queue(q))
+			return false;
+	}
+
+	return true;
+}
+
+/* The default ring is behind the ring meter, so the sessions that get no
+ * slot share the LRO rings.
+ */
+static int ifc_overflow_ring_get(void)
+{
+	static unsigned int next;
+	int i, ring;
+
+	for (i = 0; i < IFC_LRO_RING_NUM; i++) {
+		ring = ifc_slot_ring_get(next++);
+		if (ifc_ring_is_lro(ring))
+			return ring;
+	}
+
+	return IFC_DEFAULT_RING;
+}
