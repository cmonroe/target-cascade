From: Chad Monroe <chad@monroe.io>
Date: Fri, 15 May 2026 13:41:30 -0700
Subject: [PATCH] net: ethernet: mtk_eth_soc: preserve QDMA scheduler config across SER

mtk_wed_fe_reset() re-initialises QDMA and clears per-queue programming,
leaving PPPQ rate caps gone after recovery. Snapshot qtx_cfg, qtx_sch,
and tx_sch_rate (one word on netsys v1, two on v2+) in mtk_pending_work()
before mtk_prepare_for_reset() and replay after mtk_wed_fe_reset_complete().

Based-on-patch-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c |   50 ++++++++++++++++++
 drivers/net/ethernet/mediatek/mtk_eth_soc.h |   14 +++++
 2 files changed, 64 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4780,6 +4780,50 @@ static int mtk_do_ioctl(struct net_devic
 	return -EOPNOTSUPP;
 }
 
+static void mtk_save_qdma_cfg(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	struct mtk_qdma_params *params = &eth->qdma_params;
+	int i;
+
+	for (i = 0; i < eth->soc->num_tx_queues; i++) {
+		mtk_qdma_select_page(eth, i);
+
+		params->qtx_cfg[i] =
+			mtk_r32(eth, reg_map->qdma.qtx_cfg + MTK_QTX_REG_OFS(i));
+		params->qtx_sch[i] =
+			mtk_r32(eth, reg_map->qdma.qtx_sch + MTK_QTX_REG_OFS(i));
+	}
+	mtk_w32(eth, 0, reg_map->qdma.page);
+
+	params->tx_sch[0] = mtk_r32(eth, reg_map->qdma.tx_sch_rate);
+	if (mtk_is_netsys_v2_or_greater(eth))
+		params->tx_sch[1] =
+			mtk_r32(eth, reg_map->qdma.tx_sch_rate + 0x4);
+}
+
+static void mtk_restore_qdma_cfg(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	struct mtk_qdma_params *params = &eth->qdma_params;
+	int i;
+
+	for (i = 0; i < eth->soc->num_tx_queues; i++) {
+		mtk_qdma_select_page(eth, i);
+
+		mtk_w32(eth, params->qtx_cfg[i],
+			reg_map->qdma.qtx_cfg + MTK_QTX_REG_OFS(i));
+		mtk_w32(eth, params->qtx_sch[i],
+			reg_map->qdma.qtx_sch + MTK_QTX_REG_OFS(i));
+	}
+	mtk_w32(eth, 0, reg_map->qdma.page);
+
+	mtk_w32(eth, params->tx_sch[0], reg_map->qdma.tx_sch_rate);
+	if (mtk_is_netsys_v2_or_greater(eth))
+		mtk_w32(eth, params->tx_sch[1],
+			reg_map->qdma.tx_sch_rate + 0x4);
+}
+
 static void mtk_prepare_for_reset(struct mtk_eth *eth)
 {
 	u32 val;
@@ -4823,6 +4867,7 @@ static void mtk_pending_work(struct work
 
 	mtk_hw_dump(eth);
 
+	mtk_save_qdma_cfg(eth);
 	mtk_prepare_for_reset(eth);
 	mtk_wed_fe_reset();
 	/* Run again reset preliminary configuration in order to avoid any
@@ -4874,6 +4919,7 @@ static void mtk_pending_work(struct work
 	clear_bit(MTK_RESETTING, &eth->state);
 
 	mtk_wed_fe_reset_complete();
+	mtk_restore_qdma_cfg(eth);
 
 	rtnl_unlock();
 }
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -1018,6 +1018,23 @@ struct mtk_rx_ring {
 	struct xdp_rxq_info xdp_q;
 };
 
+/* struct mtk_qdma_params -	Snapshot of QDMA scheduler state taken
+ *				before SER and reapplied after, so per-queue
+ *				PPPQ programming survives the reset.
+ * @qtx_cfg:			Reserved-buffer settings for each TX queue.
+ *				mtk_tx_alloc() re-applies the default value
+ *				post-SER, so the round-trip is a no-op today;
+ *				keep the snapshot so any future per-queue resv
+ *				override (debugfs writer, etc.) survives SER.
+ * @qtx_sch:			Scheduler / rate-cap settings for each TX queue.
+ * @tx_sch:			Top-level TX scheduler rate registers.
+ */
+struct mtk_qdma_params {
+	u32	qtx_cfg[MTK_DSA_USER_PORT_MAX];
+	u32	qtx_sch[MTK_DSA_USER_PORT_MAX];
+	u32	tx_sch[2];
+};
+
 enum mkt_eth_capabilities {
 	MTK_RGMII_BIT = 0,
 	MTK_TRGMII_BIT,
@@ -1402,6 +1419,7 @@ struct mtk_eth {
 	struct mtk_rx_ring		rx_ring_qdma;
 	struct napi_struct		tx_napi;
 	struct napi_struct		rx_napi;
+	struct mtk_qdma_params		qdma_params;
 	void				*scratch_ring;
 	dma_addr_t			phy_scratch_ring;
 	void				*scratch_head[MTK_FQ_DMA_HEAD];
