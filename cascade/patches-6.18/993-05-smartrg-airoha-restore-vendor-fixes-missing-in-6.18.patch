From: Chad Monroe <chad@monroe.io>
Date: Sat, 26 Sep 2026 16:45:17 -0700
Subject: [PATCH] net: airoha: restore vendor fixes missing in 6.18

The vendor 6.18 feed lost the GDM metadata LAN ID and the both-port
match that its earlier sources had. It also rewrote the collision
check and deletes the conntrack of each PPE entry that a clean
removes. The overlay now follows the 6.18 sources verbatim, so this
patch keeps the four older forms.

The LAN ID comes from the GDM port again. These boards name the 10G
port lan1, so the name match gives it LAN1, like a switch port. A
clean by port removes only the entries that match both ports,
because an entry that matches one port can belong to another
session. The collision check skips all VLAN tags again, because the
rewrite skips one tag only and binds a double-tagged frame without
an address compare. A clean no longer deletes the conntrack. The local
fastpath cleans the entry of a session that is idle for a second;
without loose TCP pickup, a deleted conntrack kills that connection.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/arht_dp_api.c |   47 +++++++---
 drivers/net/ethernet/airoha/arht_ppe.c    |   87 ++++++++++----------
 2 files changed, 79 insertions(+), 55 deletions(-)

--- a/drivers/net/ethernet/airoha/arht_dp_api.c
+++ b/drivers/net/ethernet/airoha/arht_dp_api.c
@@ -526,24 +526,41 @@ u8 get_dscp_from_skb(struct sk_buff *skb
 
 int airoha_get_lan_id(struct net_device *dev)
 {
-	if(dev == NULL)
+	struct airoha_gdm_dev *gdm_dev;
+	struct airoha_gdm_port *port;
+
+	if (!dev || !glb_eth)
+		return 0;
+
+	gdm_dev = airoha_ppe_get_gdm_dev(glb_eth, dev);
+	if (!airoha_is_valid_gdm_dev(glb_eth, gdm_dev))
+		return 0;
+
+	/* Only LAN-side devices carry a LAN ID */
+	if (gdm_dev->flags & AIROHA_PRIV_F_WAN)
 		return 0;
-	
-	if((dev->name[0] == 'l') && (dev->name[1] == 'a') && (dev->name[2] == 'n'))
-	{
-		if(dev->name[3] == '1')
-			return LAN1;
-		else if(dev->name[3] == '2')
-			return LAN2;
-		else if(dev->name[3] == '3')
-			return LAN3;
-		else if(dev->name[3] == '4')
-			return LAN4;
-		
+
+	port = gdm_dev->port;
+	if (!port)
+		return 0;
+
+	/*
+	 * GSW LAN ports: GDM3, nbq 1~4 → LAN1~LAN4
+	 * HSGMII LAN port: GDM4, LAN-flagged → ETH2
+	 */
+	if (port->id == AIROHA_GDM3_IDX) {
+		switch (gdm_dev->nbq) {
+		case 1: return LAN1;
+		case 2: return LAN2;
+		case 3: return LAN3;
+		case 4: return LAN4;
+		default: return 0;
+		}
 	}
-	if((dev->name[0] == 'e') && (dev->name[1] == 't') && (dev->name[2] == 'h') && (dev->name[3] != '1') && (dev->name[3] != '0') )
+
+	if (port->id == AIROHA_GDM4_IDX)
 		return ETH2;
-	
+
 	return 0;
 }
 
