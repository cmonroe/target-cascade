 		return;
 	}
 
-	if (airoha_ppe_is_wifi_dev(netdev)) {
+	if (airoha_ppe_is_wifi_dev(netdev) || arht_foe_entry_is_wifi(hwe)) {
 	    airoha_set_ppe_mac(hwe, netdev, data->eth.h_source, data->eth.h_dest, data->pppoe.sid);
-	    return; 
+	    return;
 	}
 
 	struct airoha_gdm_dev *dev = airoha_ppe_get_gdm_dev(glb_eth, netdev);
@@ -4274,6 +4330,14 @@ static int airoha_ppe_netdev_event(struc
 	switch (event) {
 	case NETDEV_UNREGISTER:
 		airoha_ppe_clean_entry_by_landev(dev);
+		fallthrough;
+	case NETDEV_DOWN:
+		/* mac80211 netdevs (AP vif down, AP_VLAN removal on STA
+		 * disconnect) never traverse the QDMA TX paths that retire
+		 * eth flows, so flush wifi flows here.
+		 */
+		if (dev->ieee80211_ptr && glb_eth)
+			airoha_flow_table_entries_wifi(&glb_eth->flow_table);
 		break;
 	default:
 		break;
