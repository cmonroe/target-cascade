@@ -3600,13 +3646,23 @@ void airoha_set_flow_destination(struct
                 AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "destination set to PON\n");
                 e->e_magic = PON;
         }
-		
+
 		if(airoha_get_lan_id(dev))
 		{
 			AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "destination set to ETH\n");
             e->e_magic = airoha_get_lan_id(dev);
 		}
 
+        if(arht_foe_entry_is_wifi(&e->data)){
+                AIROHA_LOG(AIROHA_DEBUG_LEVEL_ERR, "destination set to WIFI\n");
+                e->e_magic = WIFI;
+                /* mt76 NPU egress is fully described at rule-replace time via
+                 * dev_fill_forward_path(); no QDMA TX pass ever runs for wifi
+                 * to set tx_modified, so grant commit-eligibility here.
+                 */
+                e->tx_modified = true;
+        }
+
         return;
 }
 
