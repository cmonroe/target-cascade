From: Chad Monroe <chad@monroe.io>
Date: Tue, 30 Jun 2026 22:03:02 -0700
Subject: [PATCH] airoha: don't drive phylink for internal GDM MACs

The 6.18 mainline refactor made airoha_dev_open()/airoha_dev_stop()
connect and start phylink unconditionally. The internal GDM MACs (the
embedded switch on GDM1 and the PON MAC on GDM2) have no attachable PHY,
so bringing them up fails with "could not attach PHY: -19". This broke
GDM2/eth0, the netdev the PON stack uses for hardware offload resources,
which came up fine on 6.12.

Restore the vendor guard so only external-PHY ports drive phylink at
open/stop. setup_phylink() still runs at probe (phylink objects are
created), so no other phylink paths regress.

Fixes: OWRT-5260

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/airoha_eth.c |   33 +++++++++++++++------
 1 file changed, 25 insertions(+), 8 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2187,6 +2187,19 @@ static void airoha_qdma_gro_hw_sync(stru
 	}
 }
 
+/* Internal GDM MACs (embedded switch on GDM1, PON on GDM2) have no
+ * attachable PHY; only external-PHY ports drive phylink at open/stop.
+ * The 6.18 mainline refactor connects phylink unconditionally, which
+ * fails these ports with -ENODEV; restore the vendor guard.
+ */
+static bool airoha_is_phy_external(struct airoha_gdm_port *port)
+{
+	if (port->eth->extra_ops.sel_phy_external)
+		return port->eth->extra_ops.sel_phy_external(port);
+
+	return port->id != AIROHA_GDM1_IDX;
+}
+
 static int airoha_dev_open(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
@@ -2198,13 +2211,15 @@ static int airoha_dev_open(struct net_de
 
 	qdma = airoha_qdma_deref(dev);
 
-	err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
-	if (err) {
-		netdev_err(netdev, "could not attach PHY: %d\n", err);
-		return err;
-	}
+	if (airoha_is_phy_external(port)) {
+		err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
+		if (err) {
+			netdev_err(netdev, "could not attach PHY: %d\n", err);
+			return err;
+		}
 
-	phylink_start(dev->phylink);
+		phylink_start(dev->phylink);
+	}
 
 	netif_tx_start_all_queues(netdev);
 	err = airoha_set_vip_for_gdm_port(dev, true);
@@ -2265,8 +2280,10 @@ static int airoha_dev_stop(struct net_de
 	airoha_qdma_stop(qdma);
 	airoha_update_netdev_features(dev);
 
-	phylink_stop(dev->phylink);
-	phylink_disconnect_phy(dev->phylink);
+	if (airoha_is_phy_external(port)) {
+		phylink_stop(dev->phylink);
+		phylink_disconnect_phy(dev->phylink);
+	}
 
 	return 0;
 }
