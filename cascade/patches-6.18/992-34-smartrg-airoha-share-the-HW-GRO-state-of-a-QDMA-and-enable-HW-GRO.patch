From: Chad Monroe <chad@monroe.io>
Date: Sun, 27 Sep 2026 11:06:29 -0700
Subject: [PATCH] net: airoha: share the HW GRO state of a QDMA and enable HW GRO

All LAN net_devices share one QDMA and its LRO engine, but the
vendor HW GRO patch left each net_device in control of the engine.
A change on one net_device changed the hardware for all, and the
others reported the old state. HW GRO was also off after boot, and
no SmartOS component sets it.

A flag per QDMA now holds the wanted state, and every net_device of
the QDMA reports it. An open programs the engine from the flag. HW
GRO is on from the registration of each net_device, because a flow
on an LRO ring gets no aggregation without it. ethtool can still
turn it off. The driver does not follow a net_device that moves to
the other QDMA while it is up.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/airoha_eth.c |   92 ++++++++++++++-------
 drivers/net/ethernet/airoha/airoha_eth.h |    1 
 2 files changed, 64 insertions(+), 29 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -536,12 +536,6 @@ static void airoha_fe_lro_disable(struct
 		airoha_fe_clear(eth, REG_CDM_LRO_RXQ(id, i), LRO_RXQ_MASK(i));
 }
 
-static bool airoha_fe_lro_is_enabled(struct airoha_eth *eth, int qdma_id)
-{
-	return airoha_fe_get(eth, REG_CDM_LRO_EN(qdma_id + 1),
-			     LRO_RXQ_EN_MASK);
-}
-
 static void airoha_dev_lro_enable(struct airoha_gdm_dev *dev)
 {
 	struct airoha_qdma *qdma = airoha_qdma_deref(dev);
@@ -1752,6 +1746,7 @@ static int airoha_qdma_init(struct platf
 	const char *res;
 
 	qdma->eth = eth;
+	qdma->hw_gro = true;
 	res = devm_kasprintf(eth->dev, GFP_KERNEL, "qdma%d", id);
 	if (!res)
 		return -ENOMEM;
@@ -2144,6 +2139,49 @@ static void airoha_dev_set_mtu(struct ne
 			      FIELD_PREP(WAN_MTU0_MASK, netdev->mtu + VLAN_ETH_HLEN));
 }
 
+static void airoha_dev_gro_hw_set(struct airoha_gdm_dev *dev,
+				  struct airoha_qdma *qdma, bool enable)
+{
+	struct net_device *netdev;
+
+	if (!dev || rcu_access_pointer(dev->qdma) != qdma)
+		return;
+
+	netdev = netdev_from_priv(dev);
+	if (netdev->reg_state != NETREG_REGISTERED)
+		return;
+
+	if (enable)
+		netdev->wanted_features |= NETIF_F_GRO_HW;
+	else
+		netdev->wanted_features &= ~NETIF_F_GRO_HW;
+	netdev_update_features(netdev);
+}
+
+/* The CDM LRO engine serves the whole QDMA, so every net_device on the
+ * QDMA must report the same state.
+ */
+static void airoha_qdma_gro_hw_sync(struct airoha_gdm_dev *dev,
+				    struct airoha_qdma *qdma, bool enable)
+{
+	struct airoha_eth *eth = dev->eth;
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			if (port->devs[j] == dev)
+				continue;
+
+			airoha_dev_gro_hw_set(port->devs[j], qdma, enable);
+		}
+	}
+}
+
 static int airoha_dev_open(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
@@ -2151,16 +2189,9 @@ static int airoha_dev_open(struct net_de
 	struct airoha_eth *eth = dev->eth;
 	struct airoha_qdma *qdma;
 	u32 pse_port = FE_PSE_PORT_PPE1;
-	int err, qdma_id;
-
+	int err;
 
 	qdma = airoha_qdma_deref(dev);
-	qdma_id = qdma - &eth->qdma[0];
-
-	if (qdma->users && airoha_fe_lro_is_enabled(eth, qdma_id)) {
-		netdev_warn(netdev, "opening HW GRO on QDMA%d\n",
-			    qdma_id);
-	}
 
 	err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
 	if (err) {
@@ -2194,8 +2225,13 @@ static int airoha_dev_open(struct net_de
 	airoha_set_gdm_port_fwd_cfg(eth, REG_GDM_FWD_CFG(port->id),
 				    pse_port);
 
-	if (netdev->features & NETIF_F_GRO_HW)
+	/* The QDMA holds the wanted state. A GDM3 or GDM4 net_device can
+	 * move to the other QDMA, so its feature bit can differ from it.
+	 */
+	if (qdma->hw_gro)
 		airoha_dev_lro_enable(dev);
+	if (!!(netdev->features & NETIF_F_GRO_HW) != qdma->hw_gro)
+		airoha_dev_gro_hw_set(dev, qdma, qdma->hw_gro);
 
 	airoha_update_netdev_features(dev);
 
@@ -2546,17 +2582,6 @@ int airoha_get_fe_port(struct airoha_gdm
 					   : port->id;
 }
 
-static netdev_features_t airoha_dev_fix_features(struct net_device *netdev,
-						 netdev_features_t features)
-{
-	struct airoha_gdm_dev *dev = netdev_priv(netdev);
-	struct airoha_qdma *qdma;
-
-	qdma = airoha_qdma_deref(dev);
-
-	return features;
-}
-
 static int airoha_dev_set_features(struct net_device *netdev,
 				   netdev_features_t features)
 {
@@ -2564,15 +2589,25 @@ static int airoha_dev_set_features(struc
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
 	struct airoha_qdma *qdma = airoha_qdma_deref(dev);
 	int qdma_id = qdma - &dev->eth->qdma[0];
+	bool enable = features & NETIF_F_GRO_HW;
 
 	if (!(diff & NETIF_F_GRO_HW))
 		return 0;
 
-	if (features & NETIF_F_GRO_HW)
+	/* The QDMA is in the wanted state: a sibling programmed the hardware
+	 * and now syncs this net_device, or open aligns it with the QDMA.
+	 */
+	if (qdma->hw_gro == enable)
+		return 0;
+
+	qdma->hw_gro = enable;
+	if (enable)
 		airoha_dev_lro_enable(dev);
 	else
 		airoha_fe_lro_disable(dev->eth, qdma_id);
 
+	airoha_qdma_gro_hw_sync(dev, qdma, enable);
+
 	return 0;
 }
 
@@ -3731,7 +3766,6 @@ static const struct net_device_ops airoh
 	.ndo_stop		= airoha_dev_stop,
 	.ndo_change_mtu		= airoha_dev_change_mtu,
 	.ndo_select_queue	= airoha_dev_select_queue,
-	.ndo_fix_features	= airoha_dev_fix_features,
 	.ndo_set_features	= airoha_dev_set_features,
 	.ndo_start_xmit		= airoha_dev_xmit,
 	.ndo_get_stats64        = airoha_dev_get_stats64,
@@ -4001,7 +4035,7 @@ static int airoha_alloc_gdm_device(struc
 	netdev->max_mtu = AIROHA_MAX_MTU;
 	netdev->watchdog_timeo = 5 * HZ;
 	netdev->hw_features = AIROHA_HW_FEATURES | NETIF_F_GRO_HW;
-	netdev->features |= AIROHA_HW_FEATURES;
+	netdev->features |= AIROHA_HW_FEATURES | NETIF_F_GRO_HW;
 	netdev->vlan_features = AIROHA_HW_FEATURES;
 	SET_NETDEV_DEV(netdev, eth->dev);
 
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -651,6 +651,7 @@ struct airoha_qdma {
 	void __iomem *regs;
 
 	int users;
+	bool hw_gro;
 
 	struct airoha_irq_bank irq_banks[AIROHA_MAX_NUM_IRQ_BANKS];
 
