From: Chad Monroe <chad@monroe.io>
Date: Sun, 27 Sep 2026 11:07:51 -0700
Subject: [PATCH] net: airoha: ppe: make the clean scans preemptible and atomic-safe

A clean request walks the whole PPE table with no scheduling point,
so a real-time task on the same CPU waited for the whole walk. A
timer callback also queues such a request, and the allocation of
the request could sleep there.

Each clean scan that holds no lock across its loop now gives the
scheduler a turn at a fixed interval. The two scans that hold a lock
across the loop stay as they are. A request always takes atomic
memory, because a kernel without preemption cannot detect a caller
that holds a spinlock.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/arht_ppe.c |   38 +++++++++++++++++++++--
 1 file changed, 36 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/airoha/arht_ppe.c
+++ b/drivers/net/ethernet/airoha/arht_ppe.c
@@ -14,6 +14,7 @@
 #include <linux/netdevice.h>
 #include <linux/vmalloc.h>
 #include <linux/workqueue.h>
+#include <linux/sched.h>
 #include <linux/notifier.h>
 
 #include "airoha_eth.h"
@@ -89,6 +90,26 @@ static struct workqueue_struct *clean_en
 *************************************************************************
 */
 extern spinlock_t ppe_lock;
+
+/*
+ * A full-table FOE scan walks airoha_ppe_get_total_num_entries() entries
+ * (32768 on the AN7581) at 55 to 61 ms per scan, and the 16384 SRAM entries
+ * carry almost all of it: each is a REG_PPE_RAM_CTRL request, an ACK poll
+ * and 20 register reads, about 3.5 us. Nothing else runs on that CPU until
+ * the scanner blocks or returns, so the scanners give the scheduler a turn
+ * every 128 entries, about 0.45 ms, which keeps the wake of a SCHED_FIFO
+ * task on the same CPU under a millisecond. Call only with ppe_lock
+ * released: spin_lock_bh() raises the preempt count even without kernel
+ * preemption.
+ */
+#define ARHT_PPE_SCAN_RELAX_INTERVAL	128
+
+static inline void arht_ppe_scan_relax(unsigned int idx)
+{
+	if ((idx & (ARHT_PPE_SCAN_RELAX_INTERVAL - 1)) == 0)
+		cond_resched();
+}
+
 extern int (*ra_sw_nat_hook_clean_table) (void);
 
 int (*ra_sw_nat_hook_drop_packet) (struct sk_buff * skb) = NULL;
@@ -1905,6 +1926,7 @@ int airoha_ppe_clean_entry_by_gemport(un
 
 	for (idx = 0; idx < ppe_num_entries;idx++)
 	{
+        arht_ppe_scan_relax(idx);
         foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 
 		if(foe_entry == NULL){
@@ -1966,6 +1988,7 @@ static int airoha_ppe_clean_entry_by_cha
 
 	for (idx = 0; idx < ppe_num_entries;idx++)
 	{
+        arht_ppe_scan_relax(idx);
         foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 
 		if(foe_entry == NULL){
@@ -2041,6 +2064,7 @@ static int airoha_ppe_clean_entry_by_fpo
 
 	for (idx = 0; idx < ppe_num_entries; idx++)
 	{
+		arht_ppe_scan_relax(idx);
 		foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 
 		if(foe_entry == NULL){
@@ -2106,6 +2130,7 @@ static int airoha_ppe_clean_entry_by_mac
 
 	for (idx = 0; idx < ppe_num_entries; idx++)
 	{
+		arht_ppe_scan_relax(idx);
 		foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 
 		if(foe_entry == NULL){
@@ -2224,6 +2249,7 @@ static int airoha_ppe_clean_entry_by_typ
 	
 	for (idx = 0; idx < ppe_num_entries; idx++)
 	{
+		arht_ppe_scan_relax(idx);
 		foe_entry = &foe_entry_local;
 		foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 
@@ -2292,6 +2318,7 @@ static int airoha_ppe_clean_entry_by_ip(
 
 	for (idx = 0; idx < ppe_num_entries; idx++)
 	{
+		arht_ppe_scan_relax(idx);
 		foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 		if(foe_entry == NULL){
 			continue;
@@ -2385,6 +2412,7 @@ static int airoha_ppe_clean_entry_by_por
     ppe_num_entries = airoha_ppe_get_total_num_entries(glb_eth->ppe);
     for (idx = 0; idx < ppe_num_entries; idx++)
     {
+        arht_ppe_scan_relax(idx);
         foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
         if (foe_entry == NULL) {
             continue;
@@ -2483,6 +2511,7 @@ static int airoha_ppe_clean_entry_by_lan
 
 	for (idx = 0; idx < ppe_num_entries; idx++)
 	{
+		arht_ppe_scan_relax(idx);
 		foe_entry = airoha_ppe_foe_get_entry(glb_eth->ppe, idx);
 		if (foe_entry == NULL) {
 			continue;
@@ -3125,7 +3154,12 @@ static int queue_clean_entry_work(enum c
 {
     struct clean_entry_work *cew;
 
-    cew = kzalloc(sizeof(*cew), GFP_KERNEL);
+    /*
+     * The ra_sw_nat_hook_clean_entry_by_* pointers are exported and one
+     * is called from a timer callback (wifi_lo_timeout), so this runs in
+     * atomic context; both objects are tiny.
+     */
+    cew = kzalloc(sizeof(*cew), GFP_ATOMIC);
     if (!cew)
         return -ENOMEM;
 
@@ -3133,7 +3167,7 @@ static int queue_clean_entry_work(enum c
     cew->type = type;
 
     if (data_len > 0) {
-        cew->data = kmemdup(data, data_len, GFP_KERNEL);
+        cew->data = kmemdup(data, data_len, GFP_ATOMIC);
         if (!cew->data) {
             kfree(cew);
             return -ENOMEM;
