From: Chad Monroe <chad@monroe.io>
Date: Tue, 16 Dec 2025 14:10:54 -0800
Subject: [PATCH] net: dsa: mxl862xx: add device-tree driven firmware autoload

Compare the running switch firmware against the version declared in the
device tree (firmware-name + firmware-version properties). If they
differ, load the firmware blob via request_firmware() and reuse the
existing PDI flash helper (normally driven by devlink) to program it at
probe time.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
--- a/drivers/net/dsa/mxl862xx/Kconfig
+++ b/drivers/net/dsa/mxl862xx/Kconfig
@@ -3,6 +3,7 @@ config NET_DSA_MXL862
 	tristate "MaxLinear MxL862xx"
 	depends on NET_DSA
 	select CRC16
+	select FW_LOADER
 	select NET_DSA_TAG_MXL_862XX
 	select NET_DSA_TAG_MXL_862XX_8021Q
 	help
--- a/drivers/net/dsa/mxl862xx/mxl862xx-fw.c
+++ b/drivers/net/dsa/mxl862xx/mxl862xx-fw.c
@@ -112,9 +112,11 @@
 #include <linux/crc32.h>
 #include <linux/delay.h>
 #include <linux/device.h>
+#include <linux/firmware.h>
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/netdevice.h>
+#include <linux/of.h>
 #include <linux/overflow.h>
 #include <linux/rtnetlink.h>
 #include <linux/workqueue.h>
@@ -263,7 +265,8 @@ static int mxl862xx_sb_pdi_flush_last(st
 static void mxl862xx_flash_notify(struct devlink *dl, const char *status,
 				  u32 done, u32 total)
 {
-	devlink_flash_update_status_notify(dl, status, NULL, done, total);
+	if (dl)
+		devlink_flash_update_status_notify(dl, status, NULL, done, total);
 }
 
 /* Post-flash reprobe. device_reprobe() detaches the driver -- running
@@ -1153,3 +1156,64 @@ int mxl862xx_devlink_flash_update(struct
 
 	return ret;
 }
+
+int mxl862xx_firmware_autoload(struct mxl862xx_priv *priv)
+{
+	struct device *dev = &priv->mdiodev->dev;
+	const struct firmware *fw;
+	const char *fw_name;
+	u32 fw_version[3];
+	u32 payload_size;
+	int ret;
+
+	if (of_property_read_string(dev->of_node, "firmware-name", &fw_name))
+		return 0;
+
+	if (of_property_read_u32_array(dev->of_node, "firmware-version",
+				       fw_version, 3)) {
+		dev_warn(dev, "firmware-name set but firmware-version missing, skipping autoload\n");
+		return 0;
+	}
+
+	/* A loader still draining an interrupted download cannot take an
+	 * image; the self-heal reprobes once it is at READY and the autoload
+	 * runs again then.
+	 */
+	if (priv->rescue_mode && !READ_ONCE(priv->rescue_ready))
+		return 0;
+
+	if (!priv->rescue_mode &&
+	    priv->fw_version.major == fw_version[0] &&
+	    priv->fw_version.minor == fw_version[1] &&
+	    priv->fw_version.revision == fw_version[2])
+		return 0;
+
+	if (priv->rescue_mode)
+		dev_info(dev, "switch in MCUboot rescue mode, flashing %u.%u.%u from '%s'\n",
+			 fw_version[0], fw_version[1], fw_version[2], fw_name);
+	else
+		dev_info(dev, "firmware %u.%u.%u running, flashing %u.%u.%u from '%s'\n",
+			 priv->fw_version.major, priv->fw_version.minor,
+			 priv->fw_version.revision,
+			 fw_version[0], fw_version[1], fw_version[2], fw_name);
+
+	ret = request_firmware(&fw, fw_name, dev);
+	if (ret) {
+		dev_err(dev, "failed to load firmware '%s': %pe\n",
+			fw_name, ERR_PTR(ret));
+		return ret;
+	}
+
+	ret = mxl862xx_flash_validate(priv, fw, &payload_size);
+	if (!ret)
+		ret = mxl862xx_flash_firmware(priv, fw, payload_size, NULL);
+	release_firmware(fw);
+	if (ret) {
+		dev_err(dev, "firmware autoload failed: %pe\n", ERR_PTR(ret));
+		return ret;
+	}
+
+	priv->rescue_mode = false;
+
+	return mxl862xx_wait_ready(priv->ds);
+}
--- a/drivers/net/dsa/mxl862xx/mxl862xx-fw.h
+++ b/drivers/net/dsa/mxl862xx/mxl862xx-fw.h
@@ -16,5 +16,6 @@ int mxl862xx_devlink_info_get(struct dsa
 int mxl862xx_devlink_flash_update(struct dsa_switch *ds,
 				  struct devlink_flash_update_params *params,
 				  struct netlink_ext_ack *extack);
+int mxl862xx_firmware_autoload(struct mxl862xx_priv *priv);
 
 #endif /* __MXL862XX_FW_H */
--- a/drivers/net/dsa/mxl862xx/mxl862xx.c
+++ b/drivers/net/dsa/mxl862xx/mxl862xx.c
@@ -1200,6 +1200,10 @@ static int mxl862xx_setup(struct dsa_swi
 
 	priv->rescue_mode = rescue;
 
+	ret = mxl862xx_firmware_autoload(priv);
+	if (ret)
+		return ret;
+
 	if (priv->rescue_mode) {
 		if (priv->rescue_ready) {
 			dev_warn(ds->dev,
