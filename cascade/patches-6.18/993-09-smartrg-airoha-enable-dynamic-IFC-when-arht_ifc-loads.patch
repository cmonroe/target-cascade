From: Chad Monroe <chad@monroe.io>
Date: Mon, 21 Sep 2026 10:30:00 -0700
Subject: [PATCH] net: airoha: enable dynamic IFC when arht_ifc loads

Dynamic IFC steers the TCP flows of the listed local applications to
an LRO ring and sends their packets through the hardware fast path.
Without it such a flow stays on a default RX ring behind the ring
meter. The vendor code leaves the feature off until user space
writes "enable" to /proc/dynamic_ifc, and no SmartOS component does
that. The feature is now on after boot on every AN7581 board.

The enable flag cannot be preset. The enable sequence resolves
__ECNT_HOOK from arht_hook and registers the kprobes, and the flag is
the last step. This code is built in, so the modules do not exist
when its initcall runs. A module notifier now starts the sequence
when arht_ifc goes live, because the IFC rules need arht_ifc, and
arht_ifc depends on arht_hook. The notifier runs in the context of
insmod with no module lock held, so it can register the kprobes
directly.

The driver holds a bare pointer to __ECNT_HOOK and no reference on
arht_hook. With the feature on at every boot, an unload of arht_hook
left that pointer in use by the kprobe handlers and the timers. The
notifier now runs the disable sequence when arht_ifc or arht_hook
goes away, and a new load of arht_ifc enables the feature again. For
arht_hook the pointer is cleared first, because the exit function of
a module runs before its notifier.

The /proc commands use the same two functions, so "enable" and
"disable" keep their behaviour.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/airoha/arht_dynamic_ifc.c |  122 +++++++++++++++++--------
 1 file changed, 86 insertions(+), 36 deletions(-)

--- a/drivers/net/ethernet/airoha/arht_dynamic_ifc.c
+++ b/drivers/net/ethernet/airoha/arht_dynamic_ifc.c
@@ -984,6 +984,84 @@ static int dynamic_ifc_proc_open(struct
 	return single_open(file, dynamic_ifc_seq_show, NULL);
 }
 
+static int dynamic_ifc_start(void)
+{
+	int ret = 0;
+
+	mutex_lock(&dynamic_ifc_enable_mutex);
+	if (dynamic_ifc_enable) {
+		pr_info("arht_dynamic_ifc already enabled\n");
+		goto out;
+	}
+
+	ret = difc_resolve_ecnt_hook();
+	if (ret) {
+		pr_err("arht_dynamic_ifc enable failed - __ECNT_HOOK not available!!!");
+		goto out;
+	}
+
+	ret = arht_kprobe_difc_init();
+	if (ret) {
+		difc_clear_ecnt_hook();
+		pr_err("arht_dynamic_ifc enable failed - kprobe: %d\n", ret);
+		goto out;
+	}
+
+	WRITE_ONCE(dynamic_ifc_enable, 1);
+	pr_info("arht_dynamic_ifc enabled\n");
+out:
+	mutex_unlock(&dynamic_ifc_enable_mutex);
+
+	return ret;
+}
+
+static void dynamic_ifc_stop(void)
+{
+	mutex_lock(&dynamic_ifc_enable_mutex);
+	if (dynamic_ifc_enable) {
+		arht_kprobe_difc_exit();
+		WRITE_ONCE(dynamic_ifc_enable, 0);
+		dynamic_ifc_cleanup_all_sessions();
+		WRITE_ONCE(__difc_ecnt_hook_fn, NULL);
+		pr_info("arht_dynamic_ifc disabled\n");
+	} else {
+		pr_info("arht_dynamic_ifc already disabled\n");
+	}
+	mutex_unlock(&dynamic_ifc_enable_mutex);
+}
+
+static int dynamic_ifc_module_notify(struct notifier_block *nb,
+				     unsigned long state, void *data)
+{
+	struct module *mod = data;
+	bool is_hook = !strcmp(mod->name, "arht_hook");
+
+	if (!is_hook && strcmp(mod->name, "arht_ifc"))
+		return NOTIFY_DONE;
+
+	/* The IFC rules go through arht_ifc, and arht_ifc depends on
+	 * arht_hook, which holds __ECNT_HOOK.
+	 */
+	if (state == MODULE_STATE_LIVE && !is_hook)
+		dynamic_ifc_start();
+
+	if (state != MODULE_STATE_GOING)
+		return NOTIFY_DONE;
+
+	/* The module text goes away after this chain returns, and the exit
+	 * function of the module ran already, so arht_hook gets no more calls.
+	 */
+	if (is_hook)
+		difc_clear_ecnt_hook();
+	dynamic_ifc_stop();
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block dynamic_ifc_module_nb = {
+	.notifier_call = dynamic_ifc_module_notify,
+};
+
 static ssize_t dynamic_ifc_write_proc(struct file *file, const char __user *buf, size_t count, loff_t *ppos)
 {
 	char str[64] = {0};
@@ -1008,43 +1086,11 @@ static ssize_t dynamic_ifc_write_proc(st
 
 	if (!strcmp(cmd, "enable")) 
 	{
-		mutex_lock(&dynamic_ifc_enable_mutex);
-		if (!dynamic_ifc_enable) 
-		{
-			ret = difc_resolve_ecnt_hook();
-			if (ret == 0)
-			{
-				ret = arht_kprobe_difc_init();
-				if (ret == 0) {
-					WRITE_ONCE(dynamic_ifc_enable, 1);
-					pr_info("arht_dynamic_ifc enabled\n");
-				} else {
-					difc_clear_ecnt_hook();
-					pr_err("arht_dynamic_ifc enable failed - kprobe: %d\n", ret);
-					mutex_unlock(&dynamic_ifc_enable_mutex);
-					return ret;
-				}
-			} else {
-				pr_err("arht_dynamic_ifc enable failed - __ECNT_HOOK not available!!!");
-				mutex_unlock(&dynamic_ifc_enable_mutex);
-				return -ENODEV;
-			}
-		} else {
-			pr_info("arht_dynamic_ifc already enabled\n");
-		}
-		mutex_unlock(&dynamic_ifc_enable_mutex);
+		ret = dynamic_ifc_start();
+		if (ret)
+			return ret;
 	} else if (!strcmp(cmd, "disable")) {
-		mutex_lock(&dynamic_ifc_enable_mutex);
-		if (dynamic_ifc_enable) {
-			arht_kprobe_difc_exit();
-			WRITE_ONCE(dynamic_ifc_enable, 0);
-			dynamic_ifc_cleanup_all_sessions();
-			WRITE_ONCE(__difc_ecnt_hook_fn, NULL);
-			pr_info("arht_dynamic_ifc disabled\n");
-		} else {
-			pr_info("arht_dynamic_ifc already disabled\n");
-		}
-		mutex_unlock(&dynamic_ifc_enable_mutex);
+		dynamic_ifc_stop();
 	} else if (!strcmp(cmd, "debug")) {
 		if (sscanf(str, "%31s %d", cmd, &val) == 2) {
 			if (val) {
@@ -1122,11 +1168,15 @@ static int __init arht_dynamic_ifc_init(
 	dynamic_ifc_app_list_add("iperf3");
 	dynamic_ifc_app_list_add("ookla");
 
+	register_module_notifier(&dynamic_ifc_module_nb);
+
 	return 0;
 }
 
 static void __exit arht_dynamic_ifc_exit(void)
 {
+	unregister_module_notifier(&dynamic_ifc_module_nb);
+
 	if (df_proc_entry) {
 		remove_proc_entry("dynamic_ifc", NULL);
 		df_proc_entry = NULL;
