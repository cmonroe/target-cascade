From: Chad Monroe <chad@monroe.io>
Date: Thu, 24 Sep 2026 20:09:29 -0700
Subject: [PATCH] net: ethernet: mtk_ppe: report L3 bytes for offloaded flows

The PPE MIB counts each packet with the L2 headers it came in with,
while conntrack counts L3 bytes on the software path. One flow mixed
two byte meanings, with 14 or more bytes per offloaded packet.

Routed flows now report their bytes without the Ethernet, VLAN, PPPoE
and DSA tag headers of the ingress side of each packet. The headers
come from the flowtable tuple, because the rule has no key for PPPoE
or for a VLAN tag that a DSA switch adds. The ingress device lookup
runs under RCU, because the flowtable worker holds no RTNL.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_ppe.h         |    1 
 drivers/net/ethernet/mediatek/mtk_ppe_offload.c |  105 +++++++++++++++++++-----
 2 files changed, 85 insertions(+), 21 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -304,6 +304,7 @@ struct mtk_flow_entry {
 	u8 type;
 	s8 wed_index;
 	u8 ppe_index;
+	u8 l2_len; /* bytes per packet the MIB counts beyond L3 */
 	u16 hash;
 	struct mtk_foe_entry data;
 	struct rhash_head node;
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -4,6 +4,8 @@
  */
 
 #include <linux/if_ether.h>
+#include <linux/if_pppox.h>
+#include <linux/if_vlan.h>
 #include <linux/rhashtable.h>
 #include <linux/ip.h>
 #include <linux/ipv6.h>
@@ -417,6 +419,56 @@ mtk_flow_is_valid_idev(const struct mtk_
 	return false;
 }
 
+/* The flowtable uses the address of the tuple as the cookie. */
+static const struct flow_offload_tuple *
+mtk_flow_tuple_get(struct flow_cls_offload *f)
+{
+	int dir;
+
+	if (!f->flow)
+		return NULL;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++)
+		if (f->cookie == (unsigned long)&f->flow->tuplehash[dir].tuple)
+			return &f->flow->tuplehash[dir].tuple;
+
+	return NULL;
+}
+
+/* The MIB counts a packet with the L2 headers it came in with, conntrack
+ * counts L3. The rule has no key for an ingress PPPoE header or for a
+ * VLAN tag that a DSA switch adds, but the flowtable tuple names them.
+ */
+static u8
+mtk_flow_ingress_l2_len(struct flow_cls_offload *f, struct flow_rule *rule,
+			bool dsa_ingress)
+{
+	const struct flow_offload_tuple *tuple = mtk_flow_tuple_get(f);
+	u8 len = ETH_HLEN;
+	int i;
+
+	/* The MTK tag and the MxL862 802.1Q tag both have 4 bytes. */
+	if (dsa_ingress)
+		len += 4;
+
+	if (!tuple) {
+		if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN))
+			len += VLAN_HLEN;
+		if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN))
+			len += VLAN_HLEN;
+		return len;
+	}
+
+	for (i = 0; i < tuple->encap_num; i++) {
+		if (tuple->encap[i].proto == htons(ETH_P_PPP_SES))
+			len += PPPOE_SES_HLEN;
+		else
+			len += VLAN_HLEN;
+	}
+
+	return len;
+}
+
 static int
 mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
 			 int ppe_index)
@@ -428,6 +480,7 @@ mtk_flow_offload_replace(struct mtk_eth
 	struct mtk_foe_entry foe;
 	struct mtk_flow_entry *entry;
 	struct mtk_flow_entry *stale;
+	bool dsa_ingress = false;
 	int offload_type = 0;
 	int wed_index = -1;
 	u16 addr_type = 0;
@@ -440,29 +493,35 @@ mtk_flow_offload_replace(struct mtk_eth
 
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META)) {
 		struct flow_match_meta match;
+		int ppe_idx = -1;
 
 		flow_rule_match_meta(rule, &match);
-		if (mtk_is_netsys_v2_or_greater(eth)) {
-			idev = __dev_get_by_index(&init_net, match.key->ingress_ifindex);
-			/*
-			 * If idev is a DSA user netdev, substitute it with
-			 * its conduit so the valid-idev check below passes
-			 * and ppe_index picks up the conduit's PPE engine.
-			 * Without this, upstream flows from a DSA user port
-			 * (e.g. MxL862xx lanN) install on ppe[0] while the
-			 * conduit's GDMA routes ingress through its own
-			 * ppe[mac->ppe_idx]; the lookup misses and the
-			 * flow never binds in HW.
-			 */
-			mtk_flow_get_dsa_port(&idev, NULL);
-			if (mtk_flow_is_valid_idev(eth, idev)) {
-				struct mtk_mac *mac = netdev_priv(idev);
+		rcu_read_lock();
+		idev = dev_get_by_index_rcu(&init_net, match.key->ingress_ifindex);
+		/*
+		 * If idev is a DSA user netdev, substitute it with
+		 * its conduit so the valid-idev check below passes
+		 * and ppe_index picks up the conduit's PPE engine.
+		 * Without this, upstream flows from a DSA user port
+		 * (e.g. MxL862xx lanN) install on ppe[0] while the
+		 * conduit's GDMA routes ingress through its own
+		 * ppe[mac->ppe_idx]; the lookup misses and the
+		 * flow never binds in HW.
+		 */
+		dsa_ingress = mtk_flow_get_dsa_port(&idev, NULL) >= 0;
+		if (mtk_is_netsys_v2_or_greater(eth) &&
+		    mtk_flow_is_valid_idev(eth, idev)) {
+			struct mtk_mac *mac = netdev_priv(idev);
+
+			ppe_idx = mac->ppe_idx;
+		}
+		rcu_read_unlock();
 
-				if (WARN_ON(mac->ppe_idx >= eth->soc->ppe_num))
-					return -EINVAL;
+		if (ppe_idx >= 0) {
+			if (WARN_ON(ppe_idx >= eth->soc->ppe_num))
+				return -EINVAL;
 
-				ppe_index = mac->ppe_idx;
-			}
+			ppe_index = ppe_idx;
 		}
 	} else {
 		return -EOPNOTSUPP;
@@ -686,6 +745,8 @@ mtk_flow_offload_replace(struct mtk_eth
 	memcpy(&entry->data, &foe, sizeof(entry->data));
 	entry->wed_index = wed_index;
 	entry->ppe_index = ppe_index;
+	if (offload_type != MTK_PPE_PKT_TYPE_BRIDGE)
+		entry->l2_len = mtk_flow_ingress_l2_len(f, rule, dsa_ingress);
 
 	err = mtk_foe_entry_commit(eth->ppe[entry->ppe_index], entry);
 	if (err < 0)
@@ -742,8 +803,10 @@ mtk_flow_offload_stats(struct mtk_eth *e
 	packets = entry->packets;
 	bytes = entry->bytes;
 	mtk_foe_entry_get_stats(eth->ppe[entry->ppe_index], entry, &idle);
-	f->stats.pkts += entry->packets - packets;
-	f->stats.bytes += entry->bytes - bytes;
+	packets = entry->packets - packets;
+	bytes = entry->bytes - bytes;
+	f->stats.pkts += packets;
+	f->stats.bytes += bytes - packets * entry->l2_len;
 	f->stats.lastused = jiffies - idle * HZ;
 
 	return 0;
