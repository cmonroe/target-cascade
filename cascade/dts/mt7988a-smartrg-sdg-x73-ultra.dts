#include "mt7988-smartrg-base.dtsi"
#include "mt7988-smartrg-sysled.dtsi"
#include "mt7988-smartrg-wifi-mt7995.dtsi"

/ {
	model = "SmartRG SDG X73 Ultra";
	compatible = "smartrg,sdg-x73-ultra", "mediatek,mt7988a";

	aliases {
		label-mac-device = &gmac2;
	};

	chosen {
		linux,usable-memory-range = <0x0 0x40000000 0x0 0x3fc00000>;
	};

	gpio-keys {
		button-sync {
			label = "sync";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 14 GPIO_ACTIVE_LOW>;
		};
	};

	leds: gpio-leds {
		compatible = "gpio-leds";

		lan2_amber {
			color = <LED_COLOR_ID_AMBER>;
			function = "lan2";
			gpios = <&pio 60 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "mt7530-0:03:100Mbps";
		};

		lan2_green {
			color = <LED_COLOR_ID_GREEN>;
			function = "lan2";
			gpios = <&pio 61 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "mt7530-0:03:1Gbps";
		};
	};
};

&button_pins {
	pins = "GPIO_RESET", "GPIO_WPS";
};

&gmac0 {
	nvmem-cells = <&macaddr 0x1>;
	nvmem-cell-names = "mac-address";
	label = "dsa0";

	status = "okay";
};

&gmac1 {
	nvmem-cells = <&macaddr 0x1>;
	nvmem-cell-names = "mac-address";
	label = "lan1";
	phy-mode = "usxgmii";
	managed = "in-band-status";
	phy = <&phy1>;

	status = "okay";
};

&gmac2 {
	nvmem-cells = <&macaddr 0x0>;
	nvmem-cell-names = "mac-address";
	label = "wan";
	phy-mode = "usxgmii";
	managed = "in-band-status";
	phy = <&phy2>;

	status = "okay";
};

&gsw_phy0 {
	status = "disabled";
};

&gsw_phy1 {
	status = "disabled";
};

&gsw_phy2 {
	status = "disabled";
};

&mdio_bus {
	phy1: ethernet-phy@1 {
		/* Realtek RTL8261 - LAN1 */
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <1>;
		#thermal-sensor-cells = <0>;

		reset-gpios = <&pio 62 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <221000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_ORANGE>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
			};

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
			};
		};
	};

	phy2: ethernet-phy@2 {
		/* Realtek RTL8261 - WAN */
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <2>;
		#thermal-sensor-cells = <0>;

		reset-gpios = <&pio 71 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <221000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_WAN;
				active-low;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_ORANGE>;
				function = LED_FUNCTION_WAN;
			};

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_WAN;
			};
		};
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_1_pins>;
	wifi-reset-gpios = <&pio 7 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <100>;
	wifi-deassert-msleep = <500>;
};

&pcie1 {
	status = "okay";
};

&pio {
	pcie0_1_pins: pcie0-pins-g1 {
		mux {
			function = "pcie";
			groups = "pcie_2l_0_pereset";
		};
	};
};

&ssusb1 {
	status = "okay";
	mediatek,u3p-dis-msk = <0x1>;
};

&switch {
	status = "okay";

	ports {
		port@0 {
			status = "disabled";
		};

		port@1 {
			status = "disabled";
		};

		port@2 {
			status = "disabled";
		};

		port@3 {
			label = "lan2";
		};
	};
};

&tphy {
	status = "okay";
};

&xsphy {
	status = "okay";
};
